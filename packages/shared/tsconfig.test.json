{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  // include/exclude дочернего конфига перекрывают родительские,
  // поэтому тесты здесь снова попадают в проверку типов.
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
